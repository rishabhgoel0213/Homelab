#!/usr/bin/env bash
set -euo pipefail

target="${1:-codex}"
server="${MACBOOK_BUILD_SERVER:-nixos-pc}"
ops_repo="${DARWIN_OPS_ROOT:-/srv/ops}"
nix_bin="${NIX_BIN:-nix}"
ssh_bin="${MACBOOK_SSH_BIN:-/usr/bin/ssh}"

need() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Missing required command: $1" >&2
    exit 1
  fi
}

need "$ssh_bin"
need rsync

export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-$ssh_bin}"

case "$target" in
  codex|zen|macbook-system)
    ;;
  system)
    target="macbook-system"
    ;;
  *)
    echo "Unknown Darwin build target: $target" >&2
    echo "Expected one of: codex, zen, macbook-system" >&2
    exit 2
    ;;
esac

case "$target" in
  codex)
    remote_installable=".#packages.x86_64-linux.macbook-$target"
    output="$({
      "$ssh_bin" "$server" bash -s -- "$ops_repo" "$remote_installable" <<'REMOTE'
set -euo pipefail
repo="$1"
installable="$2"
cd "$repo"
test -z "$(git status --porcelain)"
nix build --impure --no-link --print-out-paths "$installable"
REMOTE
    })"

    if [[ -z "$output" || "$output" != /nix/store/* ]]; then
      echo "Unexpected server build output: $output" >&2
      exit 1
    fi

    stage_root="$(mktemp -d "${TMPDIR:-/tmp}/darwin-server-artifacts.XXXXXX")"
    echo "Staging $output from $server without importing or activating it" >&2
    rsync -a -e "$ssh_bin" "$server:$output" "$stage_root/"
    printf '%s/%s\n' "$stage_root" "$(basename "$output")"
    exit 0
    ;;
esac

need "$nix_bin"

ops_rev="$({
  "$ssh_bin" "$server" bash -s -- "$ops_repo" <<'REMOTE'
set -euo pipefail
repo="$1"
cd "$repo"
test -z "$(git status --porcelain)"
git rev-parse HEAD
REMOTE
})"

if [[ -z "$ops_rev" ]]; then
  echo "Unable to resolve the committed server revision" >&2
  exit 1
fi

flake="git+ssh://${server}${ops_repo}?rev=${ops_rev}&shallow=1"
installable="${flake}#packages.aarch64-darwin.${target}"

echo "Building committed $installable locally without activation" >&2
"$nix_bin" build \
  --extra-experimental-features "nix-command flakes" \
  --impure \
  --no-link \
  --print-out-paths \
  "$installable"
