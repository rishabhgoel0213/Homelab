#!/usr/bin/env bash
set -euo pipefail

repo="${DARWIN_OPS_ROOT:-/srv/ops}"
configuration="${1:-macbook}"
ssh_host="${MACBOOK_SSH_HOST:-rishabhgoel@macbook.tail2f4d27.ts.net}"

need() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Missing required command: $1" >&2
    exit 1
  fi
}

need nix
need ssh

if [[ "${MACBOOK_DEPLOY_CONFIRM:-}" != "deploy" ]]; then
  cat >&2 <<EOF
Refusing to build or activate the MacBook configuration without an explicit confirmation.

Review hosts/macbook/README.md, then run:
  MACBOOK_DEPLOY_CONFIRM=deploy $0 $configuration

Optional connection overrides:
  MACBOOK_SSH_HOST=user@tailscale-name
  MACBOOK_NIX_STORE=ssh-ng://user@tailscale-name
EOF
  exit 2
fi

if [[ ! -d "$repo" ]]; then
  echo "Missing ops repository: $repo" >&2
  exit 1
fi

cd "$repo"

"$repo/hosts/macbook/copy-apps"

echo "Building the committed Darwin system locally on $ssh_host" >&2
system_path="$({
  ssh "$ssh_host" \
    "env NIX_BIN=/nix/var/nix/profiles/default/bin/nix MACBOOK_BUILD_SERVER=nixos-pc DARWIN_OPS_ROOT=/srv/ops /bin/bash -s -- macbook-system" \
    < "$repo/hosts/macbook/build-from-mac"
})"

if [[ -z "$system_path" || "$system_path" != /nix/store/* ]]; then
  echo "Unexpected system output path: $system_path" >&2
  exit 1
fi

echo "Activating $system_path on $ssh_host" >&2
ssh -t "$ssh_host" \
  "sudo -H /nix/var/nix/profiles/default/bin/nix-env -p /nix/var/nix/profiles/system --set '$system_path' && sudo -H '$system_path/activate'"
