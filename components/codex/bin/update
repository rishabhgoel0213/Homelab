#!/usr/bin/env bash
set -euo pipefail

repo="${CODEX_OPS_ROOT:-/srv/ops}"
host="${HOST:-nixos-pc}"
package_file="${CODEX_PACKAGE_FILE:-$repo/components/codex/release.nix}"
manifest_file="${CODEX_ARTIFACT_FILE:-$repo/components/darwin-deploy/artifacts.nix}"
target="${1:-latest}"

for command in git jq nix perl; do
  if ! command -v "$command" >/dev/null 2>&1; then
    echo "Missing required command: $command" >&2
    exit 1
  fi
done

if [[ ! -f "$package_file" ]]; then
  echo "Missing package file: $package_file" >&2
  exit 1
fi

if [[ "$target" == "latest" ]]; then
  tag="$(
    git ls-remote --tags --refs https://github.com/openai/codex.git 'refs/tags/rust-v*' \
      | awk -F/ '{print $NF}' \
      | grep -E '^rust-v[0-9]+\.[0-9]+\.[0-9]+$' \
      | sort -V \
      | tail -1
  )"
else
  tag="${target#refs/tags/}"
  if [[ "$tag" != rust-v* ]]; then
    tag="rust-v$tag"
  fi
fi

if [[ ! "$tag" =~ ^rust-v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "Expected a stable Codex release tag, got: $tag" >&2
  exit 1
fi

version="${tag#rust-v}"
current_version="$(perl -ne 'if (/version = "([^"]+)";/) { print $1; exit }' "$package_file")"
archive_target="$(perl -ne 'if (/target = "([^"]+)";/) { print $1; exit }' "$package_file")"
if [[ ! "$archive_target" =~ ^[a-zA-Z0-9_-]+$ ]] || ! grep -q 'archiveHash = "sha256-' "$package_file"; then
  echo "Package must declare a complete release archive target and archiveHash." >&2
  exit 1
fi

if [[ "${CODEX_UPDATE_FORCE:-0}" != "1" && "$current_version" == "$version" ]]; then
  echo "Codex package already at $version." >&2
  exit 0
fi

# Fetch the COMPLETE platform archive. Upstream owns its bundle inventory;
# there is no local list of binaries, resources, or optional features to update.
echo "Updating complete Codex package to $tag ($archive_target)" >&2
archive_url="https://github.com/openai/codex/releases/download/$tag/codex-package-$archive_target.tar.gz"
archive_hash="$(nix store prefetch-file --json "$archive_url" | jq -er '.hash')"
mac_target="$(perl -ne 'if (/macTarget = "([^"]+)";/) { print $1; exit }' "$package_file")"
if [[ ! "$mac_target" =~ ^[a-zA-Z0-9_-]+$ ]]; then
  echo "Missing Mac target in release pin." >&2
  exit 1
fi
mac_hash="$(nix store prefetch-file --json "https://github.com/openai/codex/releases/download/$tag/codex-provisioned-package-$mac_target.tar.gz" | jq -er '.hash')"
if [[ ! "$archive_hash" =~ ^sha256-[A-Za-z0-9+/]{43}=$ || ! "$mac_hash" =~ ^sha256-[A-Za-z0-9+/]{43}=$ ]]; then
  echo "Invalid archive hash returned by Nix." >&2
  exit 1
fi

# Restore the previous pin if validation fails, so tomorrow's run can retry.
# Never overwrite an intervening edit made by another process.
update_dir="$(mktemp -d)"
cp -p "$package_file" "$update_dir/original"
cp -p "$manifest_file" "$update_dir/manifest-original"
candidate_hash=""
manifest_hash=""
finish() {
  status=$?
  if [[ "$status" -ne 0 && -n "$candidate_hash" ]]; then
    if [[ "$(sha256sum "$package_file" | awk '{print $1}')" == "$candidate_hash" ]]; then
      cp -p "$update_dir/original" "$package_file"
      echo "Codex validation failed; restored the previous package pin." >&2
    else
      echo "Package changed during validation; leaving the concurrent edit intact." >&2
    fi
  fi
  if [[ "$status" -ne 0 && -n "$manifest_hash" ]] &&
     [[ "$(sha256sum "$manifest_file" | awk '{print $1}')" == "$manifest_hash" ]]; then
    cp -p "$update_dir/manifest-original" "$manifest_file"
  fi
  rm -f "$update_dir/original" "$update_dir/candidate" "$update_dir/manifest-original" "$update_dir/manifest-candidate"
  rmdir "$update_dir"
}
trap finish EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

CODEX_NEW_VERSION="$version" CODEX_NEW_ARCHIVE_HASH="$archive_hash" CODEX_NEW_MAC_HASH="$mac_hash" \
  perl -0pe '
    s{version = "[^"]+";}{version = "$ENV{CODEX_NEW_VERSION}";};
    s{archiveHash = "sha256-[^"]+";}{archiveHash = "$ENV{CODEX_NEW_ARCHIVE_HASH}";};
    s{macArchiveHash = "sha256-[^"]+";}{macArchiveHash = "$ENV{CODEX_NEW_MAC_HASH}";};
  ' "$update_dir/original" > "$update_dir/candidate"
candidate_hash="$(sha256sum "$update_dir/candidate" | awk '{print $1}')"
if [[ "$(sha256sum "$package_file" | awk '{print $1}')" != "$(sha256sum "$update_dir/original" | awk '{print $1}')" ]]; then
  echo "Package changed while preparing the update; refusing to overwrite it." >&2
  exit 1
fi
cp "$update_dir/candidate" "$package_file"

mac_output="$(cd "$repo" && nix build --impure --no-link --print-out-paths .#macbook-codex)"
if [[ ! "$mac_output" =~ ^/nix/store/[a-z0-9]{32}-codex-darwin-bundle-[0-9.]+$ ]]; then
  echo "Unexpected Mac package output: $mac_output" >&2
  exit 1
fi
CODEX_MAC_OUTPUT="$mac_output" perl -0pe \
  's{codex = "[^"]+";}{codex = "$ENV{CODEX_MAC_OUTPUT}";};' \
  "$update_dir/manifest-original" > "$update_dir/manifest-candidate"
if [[ "$(sha256sum "$manifest_file" | awk '{print $1}')" != "$(sha256sum "$update_dir/manifest-original" | awk '{print $1}')" ]]; then
  echo "Mac manifest changed concurrently; refusing to overwrite it." >&2
  exit 1
fi
manifest_hash="$(sha256sum "$update_dir/manifest-candidate" | awk '{print $1}')"
cp "$update_dir/manifest-candidate" "$manifest_file"

(
  cd "$repo"
  # Includes package inventory verification and the voice runtime smoke test.
  nix build --impure --no-link ".#nixosConfigurations.$host.config.system.build.toplevel"
)

if [[ "$(sha256sum "$package_file" | awk '{print $1}')" != "$candidate_hash" ]]; then
  echo "Package changed during validation; refusing to report a successful update." >&2
  exit 1
fi
if [[ "$(sha256sum "$manifest_file" | awk '{print $1}')" != "$manifest_hash" ]]; then
  echo "Mac manifest changed during validation; refusing to report success." >&2
  exit 1
fi
echo "Complete Codex package updated to $version." >&2
