#!/usr/bin/env bash
set -euo pipefail

checkout="/home/rishabh/Projects/t3code"
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
state_dir="/srv/state/t3code-mobile"
updates_url="https://updates.internal.therealrishabh.com/api/manifest"
apk_path="$state_dir/t3code-preview.apk"
keystore_path="$state_dir/preview.keystore"

expected_revision="$(
  nix eval --raw --impure \
    .#nixosConfigurations.nixos-pc.config.homelab.t3code.revision
)"
actual_revision="$(git -C "$checkout" rev-parse HEAD)"
if [[ "$actual_revision" != "$expected_revision" ]]; then
  echo "T3 Code checkout is at $actual_revision; expected $expected_revision" >&2
  exit 1
fi
if [[ ! -x "$checkout/apps/mobile/node_modules/.bin/expo" ]]; then
  echo "T3 Code dependencies are missing; run pnpm install in $checkout first" >&2
  exit 1
fi

install -d -m 0750 "$state_dir"

android_shell='let
  pkgs = import <nixpkgs> {
    config = {
      android_sdk.accept_license = true;
      allowUnfree = true;
    };
  };
  android = pkgs.androidenv.composeAndroidPackages {
    platformToolsVersion = "36.0.2";
    platformVersions = [ "36" ];
    buildToolsVersions = [ "35.0.0" "36.0.0" ];
    includeNDK = true;
    ndkVersions = [ "27.0.12077973" "27.1.12297006" ];
    includeCmake = true;
    cmakeVersions = [ "3.22.1" ];
  };
in pkgs.symlinkJoin {
  name = "t3code-android-build-env";
  paths = [ android.androidsdk pkgs.jdk17 pkgs.nodejs_24 pkgs.git ];
}'

export APP_VARIANT=preview
export EXPO_NO_DOTENV=1
export EXPO_NO_GIT_STATUS=1
export T3CODE_MOBILE_UPDATES_URL="$updates_url"
export GRADLE_USER_HOME="$state_dir/gradle"
export JAVA_HOME="$(nix eval --raw nixpkgs#jdk17.outPath)"
export T3CODE_ANDROID_MIRROR_INIT="$script_dir/t3code-android-mirrors.init.gradle"
android_env="$(nix build --no-link --print-out-paths --impure --expr "$android_shell")"
android_sdk_overlay="$(mktemp -d)"
trap 'rm -rf "$android_sdk_overlay"' EXIT
for sdk_entry in "$android_env/libexec/android-sdk"/*; do
  if [[ "$(basename "$sdk_entry")" == "ndk-bundle" ]]; then
    continue
  fi
  ln -s "$sdk_entry" "$android_sdk_overlay/"
done

export ANDROID_HOME="$android_sdk_overlay"
export ANDROID_SDK_ROOT="$ANDROID_HOME"

cd "$checkout/apps/mobile"
nix shell "$android_env" -c bash -euo pipefail -c '
  node node_modules/expo/bin/cli prebuild --clean --platform android
  if [[ -f "'"$keystore_path"'" ]]; then
    cp "'"$keystore_path"'" android/app/debug.keystore
  else
    install -m 0600 android/app/debug.keystore "'"$keystore_path"'"
  fi
  cd android
  ./gradlew --no-daemon --stacktrace \
    --init-script "$T3CODE_ANDROID_MIRROR_INIT" \
    -PreactNativeArchitectures=arm64-v8a \
    assembleRelease
'

install -m 0644 android/app/build/outputs/apk/release/app-release.apk "$apk_path"
echo "$apk_path"
