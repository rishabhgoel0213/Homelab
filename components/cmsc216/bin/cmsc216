# shellcheck shell=bash

set -euo pipefail

: "${CMSC216_DIRECTORY_ID:?CMSC216_DIRECTORY_ID is required}"
: "${CMSC216_LOCAL_ROOT:?CMSC216_LOCAL_ROOT is required}"
: "${CMSC216_REMOTE_ROOT:?CMSC216_REMOTE_ROOT is required}"
: "${CMSC216_DATA_ROOT:?CMSC216_DATA_ROOT is required}"
: "${CMSC216_CODIUM_BIN:?CMSC216_CODIUM_BIN is required}"

ssh_alias="${CMSC216_SSH_ALIAS:-cmsc216-zaratan}"
auth_persist="${CMSC216_AUTH_PERSIST:-8h}"
sync_root="$CMSC216_LOCAL_ROOT"

ssh_bin="${CMSC216_SSH_BIN:-/usr/bin/ssh}"

die() {
  printf 'cmsc216: %s\n' "$*" >&2
  exit 1
}

note() {
  printf 'cmsc216: %s\n' "$*" >&2
}

usage() {
  cat <<'EOF'
Usage: cmsc216 COMMAND [ARGS...]

Commands:
  doctor          Check the Mac, editor, SSH, and Zaratan setup
  bootstrap       Authenticate with Duo and initialize the Zaratan account
  auth            Authenticate with Duo and cache the live SSH connection
  auth-status     Show whether a reusable Zaratan connection is active
  auth-clear      Close the cached Zaratan connection
  sync             Upload the course workspace without deleting remote files
  shell            Open a login shell in Zaratan's ~/216-sync
  run COMMAND...   Sync, then run COMMAND in the matching Zaratan directory
  test [COMMAND]   Sync, then run COMMAND (default: make test) on Zaratan
  format FILE...   Apply the course's default clang-format style
  exam-check       Check the isolated editor profile for prohibited AI tools
EOF
}

require_macos_tool() {
  local path="$1"
  local label="$2"
  [[ -x "$path" ]] || die "$label is unavailable at $path"
}

ensure_local_directories() {
  mkdir -p \
    "$CMSC216_LOCAL_ROOT" \
    "$CMSC216_DATA_ROOT" \
    "$HOME/.ssh/control"
  chmod 0700 "$HOME/.ssh" "$HOME/.ssh/control"
}

ssh_probe() {
  [[ -x "$ssh_bin" ]] || return 1
  "$ssh_bin" \
    -o BatchMode=yes \
    -o ConnectTimeout=5 \
    "$ssh_alias" true </dev/null >/dev/null 2>&1
}

ssh_master_check() {
  [[ -x "$ssh_bin" ]] || return 1
  "$ssh_bin" -O check "$ssh_alias" </dev/null >/dev/null 2>&1
}

authenticate() {
  ensure_local_directories

  if ssh_master_check; then
    note "Reusing the cached Zaratan SSH connection."
    return 0
  fi

  note "Authenticate with your UMD password and Duo. The live SSH connection will remain reusable for up to $auth_persist of idle time."
  "$ssh_bin" \
    -o BatchMode=no \
    -o PubkeyAuthentication=no \
    -o PreferredAuthentications=keyboard-interactive,password \
    -o ControlMaster=auto \
    -o "ControlPersist=$auth_persist" \
    -Nf \
    "$ssh_alias"

  ssh_master_check || die "authentication completed, but the reusable SSH connection is unavailable"
  note "Zaratan authentication is cached in a live SSH connection."
}

ensure_authenticated() {
  if ssh_probe; then
    return 0
  fi
  authenticate
  ssh_probe || die "Zaratan is still unavailable after authentication"
}

auth_status() {
  if ssh_master_check; then
    printf 'active: cached Zaratan SSH connection is available\n'
    return 0
  fi
  printf 'inactive: run cmsc216 auth to authenticate with Duo\n'
  return 1
}

auth_clear() {
  if ssh_master_check; then
    "$ssh_bin" -O exit "$ssh_alias" >/dev/null
    note "Closed the cached Zaratan SSH connection."
  else
    note "No cached Zaratan SSH connection is active."
  fi
}

remote_directory_for_cwd() {
  local relative

  case "$PWD" in
    "$sync_root")
      relative=""
      ;;
    "$sync_root"/*)
      relative="${PWD#"$sync_root"/}"
      ;;
    *)
      die "run this command from $sync_root or one of its subdirectories"
      ;;
  esac

  if [[ -n "$relative" ]]; then
    printf '%s/%s\n' "$CMSC216_REMOTE_ROOT" "$relative"
  else
    printf '%s\n' "$CMSC216_REMOTE_ROOT"
  fi
}

shell_quote() {
  printf '%q' "$1"
}

build_remote_command() {
  local remote_directory="$1"
  shift

  local command_text
  command_text="cd $(shell_quote "$remote_directory") && exec"
  while [[ "$#" -gt 0 ]]; do
    command_text+=" $(shell_quote "$1")"
    shift
  done
  printf '%s\n' "$command_text"
}

sync_to_zaratan() {
  ensure_local_directories
  ensure_authenticated

  note "Uploading $sync_root to $ssh_alias:$CMSC216_REMOTE_ROOT without remote deletion."
  rsync \
    --archive \
    --compress \
    --human-readable \
    --itemize-changes \
    --exclude=.DS_Store \
    --exclude=.git/ \
    --exclude=.vscode/ \
    --exclude=.cmsc216-sftp-backups/ \
    --rsh="$ssh_bin" \
    "$sync_root/" "$ssh_alias:$CMSC216_REMOTE_ROOT/"
}

run_remote() {
  local remote_directory
  local remote_command

  [[ "$#" -gt 0 ]] || die "run requires a command"
  remote_directory="$(remote_directory_for_cwd)"
  sync_to_zaratan
  remote_command="$(build_remote_command "$remote_directory" "$@")"
  "$ssh_bin" -t "$ssh_alias" "$remote_command"
}

check_extension_allowlist() {
  local extensions
  local forbidden_pattern

  forbidden_pattern='copilot|chatgpt|codex|claude|gemini|continue|tabnine|codeium|amazon-q|blackbox|supermaven'
  extensions="$("$CMSC216_CODIUM_BIN" \
    --user-data-dir "$CMSC216_DATA_ROOT" \
    --list-extensions 2>/dev/null || true)"

  if printf '%s\n' "$extensions" | grep -Eiq "$forbidden_pattern"; then
    printf '%s\n' "$extensions" | grep -Ei "$forbidden_pattern" >&2 || true
    die "the isolated CMSC 216 editor exposes an AI/chat extension"
  fi

  if ! printf '%s\n' "$extensions" | grep -Fixq 'llvm-vs-code-extensions.vscode-clangd'; then
    die "the managed clangd extension is missing"
  fi
}

doctor() {
  local failed=0

  if [[ "$(uname -s)" != "Darwin" ]]; then
    note "this deployment is intended for macOS; current system is $(uname -s)"
    failed=1
  fi

  for entry in \
    "$sync_root:CMSC 216 workspace" \
    "$CMSC216_DATA_ROOT:isolated VSCodium state"
  do
    path="${entry%%:*}"
    label="${entry#*:}"
    if [[ -d "$path" ]]; then
      printf 'ok: %s (%s)\n' "$label" "$path"
    else
      printf 'missing: %s (%s)\n' "$label" "$path" >&2
      failed=1
    fi
  done

  if ssh_master_check; then
    printf 'ok: reusable Zaratan SSH connection is active\n'
  else
    printf 'inactive: Zaratan authentication is not cached; run cmsc216 auth\n' >&2
    failed=1
  fi

  if "$ssh_bin" -G "$ssh_alias" 2>/dev/null | grep -Fq "hostname login.zaratan.umd.edu"; then
    printf 'ok: SSH alias %s resolves to login.zaratan.umd.edu\n' "$ssh_alias"
  else
    printf 'invalid: SSH alias %s is not using the managed Zaratan configuration\n' "$ssh_alias" >&2
    failed=1
  fi

  if ssh_probe; then
    printf 'ok: noninteractive Zaratan SSH succeeds\n'
    if "$ssh_bin" -o BatchMode=yes "$ssh_alias" \
      "test -d $(shell_quote "$CMSC216_REMOTE_ROOT") && command -v gcc >/dev/null && command -v gdb >/dev/null"; then
      printf 'ok: remote directory, gcc, and gdb are available\n'
    else
      printf 'incomplete: Zaratan course directory or toolchain is missing; run cmsc216 bootstrap\n' >&2
      failed=1
    fi
  else
    printf 'unavailable: Zaratan SSH failed; run cmsc216 auth or cmsc216 bootstrap\n' >&2
    failed=1
  fi

  if ! check_extension_allowlist; then
    failed=1
  else
    printf 'ok: isolated VSCodium extension allowlist passed\n'
  fi

  return "$failed"
}

bootstrap() {
  require_macos_tool "$ssh_bin" "macOS OpenSSH"
  ensure_local_directories
  authenticate

  note "Initializing the course environment on Zaratan."
  "$ssh_bin" -t "$ssh_alias" bash -s -- "$CMSC216_REMOTE_ROOT" <<'REMOTE'
set -euo pipefail

remote_root="$1"

umask 077
mkdir -p "$remote_root"

if [[ ! -r ~profk/bin/cmsc216-setup ]]; then
  printf 'Missing course setup script: ~profk/bin/cmsc216-setup\n' >&2
  exit 1
fi

# Zaratan's /etc/bashrc and the professor's setup script intentionally inspect
# unset shell variables. Keep strict mode for our bootstrap work, but do not
# leak nounset or our wrapper's positional arguments into their sourced code.
set +u
set --

# This is the one-time setup command required by the professor's guide.
source ~profk/bin/cmsc216-setup
REMOTE

  if ssh_probe; then
    note "Bootstrap complete. The reusable Zaratan SSH connection is working."
  else
    die "bootstrap finished, but the cached Zaratan connection is unavailable; run cmsc216 auth"
  fi
}

exam_check() {
  local failed=0

  if ! check_extension_allowlist; then
    failed=1
  else
    printf 'ok: no prohibited AI/chat extension is exposed by the isolated editor\n'
  fi

  if ssh_probe; then
    printf 'ok: Zaratan SSH is available\n'
  else
    printf 'unavailable: Zaratan SSH is not ready; run cmsc216 auth before the exam\n' >&2
    failed=1
  fi

  cat <<'EOF'
Reminder: this check covers the managed CMSC 216 editor only. Course rules also
prohibit AI, internet search, chat, email, shared documents, and unauthorized
websites during exams. It does not close or inspect other applications.
EOF

  return "$failed"
}

command="${1:-help}"
if [[ "$#" -gt 0 ]]; then
  shift
fi

case "$command" in
  help|-h|--help)
    usage
    ;;
  doctor)
    doctor
    ;;
  bootstrap)
    bootstrap
    ;;
  auth|login)
    authenticate
    ;;
  auth-status)
    auth_status
    ;;
  auth-clear|logout)
    auth_clear
    ;;
  sync)
    sync_to_zaratan
    ;;
  shell)
    ensure_local_directories
    ensure_authenticated
    "$ssh_bin" -t "$ssh_alias" \
      "cd $(shell_quote "$CMSC216_REMOTE_ROOT") && exec bash -l"
    ;;
  run)
    run_remote "$@"
    ;;
  test)
    if [[ "$#" -eq 0 ]]; then
      set -- make test
    fi
    run_remote "$@"
    ;;
  format)
    [[ "$#" -gt 0 ]] || die "format requires at least one C or header file"
    clang-format \
      -i \
      --style='{BasedOnStyle: Google, IndentWidth: 4, ColumnLimit: 80}' \
      "$@"
    ;;
  exam-check)
    exam_check
    ;;
  *)
    usage >&2
    die "unknown command: $command"
    ;;
esac
