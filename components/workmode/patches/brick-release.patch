+++ b/apps/desktop/src-tauri/src/cli/control/brick.rs
@@ -0,0 +1,46 @@
+//! Sole early-release path for Brick-owned strict sessions.
+use serde_json::Value;
+
+fn permits_release(value: &Value) -> bool {
+    value.get("schema").and_then(Value::as_u64) == Some(1)
+        && value.get("state").and_then(Value::as_str) == Some("unbricked")
+        && value.get("latchedBricked").and_then(Value::as_bool) == Some(false)
+        && value.get("ageSeconds").and_then(Value::as_f64)
+            .map(|age| age.is_finite() && (0.0..=10.0).contains(&age)).unwrap_or(false)
+}
+
+pub(super) fn require_unbricked() -> Result<(), String> {
+    // Fixed numeric tailnet destination, absolute system curl, no proxies or redirects.
+    let output = std::process::Command::new("/usr/bin/curl")
+        .args(["--silent", "--fail", "--noproxy", "*", "--connect-timeout", "2",
+            "--max-time", "3", "--max-filesize", "16384", "http://100.73.159.103:8127/state"])
+        .output().map_err(|_| "Brick bridge unavailable; lock retained")?;
+    if !output.status.success() || output.stdout.len() > 16384 {
+        return Err("Brick bridge unavailable; lock retained".into());
+    }
+    let value: Value = serde_json::from_slice(&output.stdout)
+        .map_err(|_| "Invalid Brick bridge response; lock retained")?;
+    if !permits_release(&value) {
+        return Err("Phone is bricked or its state is unknown; lock retained".into());
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+    #[test]
+    fn release_requires_explicit_fresh_unbrick() {
+        let good = json!({"schema":1,"state":"unbricked","latchedBricked":false,"ageSeconds":1.0});
+        assert!(permits_release(&good));
+        for state in ["bricked", "unknown"] {
+            let mut bad = good.clone(); bad["state"] = json!(state); assert!(!permits_release(&bad));
+        }
+        for age in [json!(11), json!(-1), Value::Null, json!("0")] {
+            let mut bad = good.clone(); bad["ageSeconds"] = age; assert!(!permits_release(&bad));
+        }
+        let mut bad = good.clone(); bad["latchedBricked"] = json!(true); assert!(!permits_release(&bad));
+        assert!(!permits_release(&json!({})));
+    }
+}
