{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "singlemail",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "INBOX_DOMAIN": "inbox.therealrishabh.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "singlemail",
      "database_id": "bdd52b67-5f74-4ec4-96ad-350dceadb858",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MESSAGES",
      "bucket_name": "singlemail-messages"
    }
  ],
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
