#!/usr/bin/env bash
set -euo pipefail

# shellcheck disable=SC1090
. "${HOMELAB_SECRETS_LIB:-/srv/ops/scripts/lib/homelab-secrets}"

# Assigned by homelab-secrets; declarations keep static analysis aware of them.
# shellcheck disable=SC2154
sops_config="${sops_config:?}"
age_key_cmd="${age_key_cmd:?}"
secrets_file="${secrets_file:?}"
homelab_user="${homelab_user:?}"
homelab_group="${homelab_group:?}"

need jq
need openssl
need sops
need sudo
require_sops_file

token_file="$(mktemp /tmp/matrix-gmessages-secret.XXXXXX)"
trap 'rm -f "$token_file"' EXIT
chmod 600 "$token_file"

for secret_name in \
  matrix-gmessages-as-token \
  matrix-gmessages-hs-token \
  matrix-gmessages-pickle-key
do
  openssl rand -hex 32 > "$token_file"
  tr -d '\n' < "$token_file" | jq -Rs . \
    | sudo env SOPS_CONFIG="$sops_config" SOPS_AGE_KEY_CMD="$age_key_cmd" \
      sops set --value-stdin "$secrets_file" "[\"$secret_name\"]"
done

sudo chown "$homelab_user:$homelab_group" "$secrets_file"
sudo chmod 600 "$secrets_file"
sops_verify

echo "Generated and encrypted the Google Messages appservice and encryption secrets."
