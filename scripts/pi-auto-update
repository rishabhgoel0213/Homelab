#!/usr/bin/env bash
set -euo pipefail

repo="${PI_OPS_ROOT:-/srv/ops}"
host="${HOST:-nixos-pc}"
target="${1:-latest}"
package_file="${PI_PACKAGE_FILE:-$repo/packages/pi-coding-agent.nix}"
lock_file="${PACKAGE_UPDATE_LOCK_FILE:-/tmp/homelab-package-update.lock}"
update_user="${PI_UPDATE_USER:-rishabh}"
update_home="${PI_UPDATE_HOME:-/home/rishabh}"
sudo_cmd="${SUDO:-/run/wrappers/bin/sudo}"

if [[ ! -x "$sudo_cmd" ]]; then
  sudo_cmd="sudo"
fi

exec 9>"$lock_file"
if ! flock -n 9; then
  echo "Another managed package update is already running." >&2
  exit 0
fi

if [[ ! -f "$package_file" ]]; then
  echo "Missing package file: $package_file" >&2
  exit 1
fi

before_hash="$(sha256sum "$package_file" | awk '{print $1}')"
before_version="$(perl -ne 'if (/version = "([^"]+)";/) { print $1; exit }' "$package_file")"

if [[ "$(id -u)" -eq 0 ]]; then
  runuser -u "$update_user" -- env \
    HOME="$update_home" \
    PI_OPS_ROOT="$repo" \
    PI_PACKAGE_FILE="$package_file" \
    HOST="$host" \
    "$repo/scripts/update-pi" "$target"
else
  "$repo/scripts/update-pi" "$target"
fi

after_hash="$(sha256sum "$package_file" | awk '{print $1}')"
after_version="$(perl -ne 'if (/version = "([^"]+)";/) { print $1; exit }' "$package_file")"

if [[ "$before_hash" == "$after_hash" ]]; then
  echo "Pi is already current at $after_version." >&2
  exit 0
fi

echo "Pi changed from $before_version to $after_version; switching NixOS generation." >&2
if [[ "$(id -u)" -eq 0 ]]; then
  runuser -u "$update_user" -- "$sudo_cmd" nixos-rebuild switch --impure --flake "$repo#$host"
else
  "$sudo_cmd" nixos-rebuild switch --impure --flake "$repo#$host"
fi
echo "Pi auto-update applied $after_version. New Pi sessions will use the updated package." >&2
